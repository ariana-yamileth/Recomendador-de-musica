# Copia este archivo como ".env" y reemplaza los datos. NUNCA subas ".env" a GitHub.
# Cadena de conexión de Atlas: Connect > Drivers > Python (ver docs/ADMINISTRACION_ATLAS.md)

# Usuario ADMINISTRADOR (atlasAdmin): carga datos, crea colecciones, índices
MONGO_URI=mongodb+srv://admin_proyecto:CAMBIAR@musica-cluster.rx0ossn.mongodb.net/?retryWrites=true&w=majority

# Usuario de la APLICACIÓN (readWrite solo en musica_recomendador): lo usa la API
MONGO_URI_APP=mongodb+srv://app_escritura:CAMBIAR@musica-cluster.rx0ossn.mongodb.net/?retryWrites=true&w=majority

# Usuario SOLO LECTURA (read solo en musica_recomendador): reportes / consultas
MONGO_URI_LECTURA=mongodb+srv://app_lectura:CAMBIAR@musica-cluster.rx0ossn.mongodb.net/?retryWrites=true&w=majority

DB_NAME=musica_recomendador
